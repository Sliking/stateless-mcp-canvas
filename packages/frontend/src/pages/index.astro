---
// Stateless MCP Pixel Canvas - Collaborative pixel art demo
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <meta name="theme-color" content="#0d1117">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <title>Stateless MCP Canvas</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --bg: #0d1117;
      --card-bg: #161b22;
      --accent: #f6821f;
      --accent-glow: rgba(246, 130, 31, 0.3);
      --text: #e6edf3;
      --text-secondary: #8b949e;
      --success: #3fb950;
      --border: #30363d;
      --error: #f85149;
      --grid-line: #1e2430;
    }

    html, body {
      height: 100%;
      overflow: hidden;
      touch-action: none;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
      background: var(--bg);
      color: var(--text);
      display: flex;
      flex-direction: column;
      -webkit-tap-highlight-color: transparent;
    }

    /* Header */
    .header {
      background: var(--card-bg);
      border-bottom: 1px solid var(--border);
      padding: 12px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
    }

    .header-title {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .header-title h1 {
      font-size: 16px;
      font-weight: 600;
      background: linear-gradient(135deg, var(--text) 0%, var(--accent) 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .accent-bar {
      width: 3px;
      height: 20px;
      background: var(--accent);
      border-radius: 2px;
    }

    .status-indicator {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 12px;
      color: var(--text-secondary);
    }

    .status-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--text-secondary);
      transition: all 0.3s ease;
    }

    .status-dot.connected {
      background: var(--success);
      box-shadow: 0 0 10px var(--success);
    }

    .status-dot.connecting {
      background: var(--accent);
      animation: pulse 1.5s ease-in-out infinite;
    }

    .status-dot.error {
      background: var(--error);
    }

    @keyframes pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.5; transform: scale(1.2); }
    }

    /* Nickname Bar */
    .nickname-bar {
      background: var(--card-bg);
      border-bottom: 1px solid var(--border);
      padding: 10px 16px;
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .nickname-label {
      font-size: 12px;
      color: var(--text-secondary);
      flex-shrink: 0;
    }

    .nickname-input {
      flex: 1;
      max-width: 200px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 8px 12px;
      color: var(--text);
      font-size: 14px;
      outline: none;
      transition: border-color 0.2s ease;
    }

    .nickname-input:focus {
      border-color: var(--accent);
    }

    /* Main Canvas Area */
    .canvas-container {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 16px;
      overflow: hidden;
    }

    #pixel-canvas {
      background: var(--bg);
      border-radius: 8px;
      touch-action: none;
      cursor: crosshair;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
    }

    /* Color Picker Bar */
    .color-picker {
      background: var(--card-bg);
      border-top: 1px solid var(--border);
      padding: 14px 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      flex-shrink: 0;
      flex-wrap: wrap;
    }

    .color-picker-label {
      font-size: 16px;
      margin-right: 4px;
    }

    .color-swatch {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      border: 2px solid transparent;
      cursor: pointer;
      transition: all 0.2s ease;
      flex-shrink: 0;
    }

    .color-swatch:hover {
      transform: scale(1.1);
    }

    .color-swatch.selected {
      border-color: var(--text);
      transform: scale(1.15);
      box-shadow: 0 0 12px currentColor;
    }

    .color-swatch:active {
      transform: scale(0.95);
    }

    /* Stats Bar */
    .stats-bar {
      background: var(--card-bg);
      border-top: 1px solid var(--border);
      padding: 10px 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      font-size: 13px;
      color: var(--text-secondary);
      flex-shrink: 0;
    }

    .stat-item {
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .stat-value {
      color: var(--text);
      font-weight: 600;
    }

    .isolate-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      transition: background-color 0.3s ease;
    }

    /* Isolate color palette */
    .isolate-0 { background: #f6821f; }
    .isolate-1 { background: #3fb950; }
    .isolate-2 { background: #8884d8; }
    .isolate-3 { background: #82ca9d; }
    .isolate-4 { background: #ffc658; }
    .isolate-5 { background: #ff8080; }
    .isolate-6 { background: #80c8ff; }
    .isolate-7 { background: #c880ff; }

    /* Responsive adjustments */
    @media (min-width: 768px) {
      .header {
        padding: 14px 24px;
      }

      .header-title h1 {
        font-size: 20px;
      }

      .nickname-bar {
        padding: 12px 24px;
      }

      .canvas-container {
        padding: 24px;
      }

      .color-picker {
        padding: 16px 24px;
        gap: 14px;
      }

      .color-swatch {
        width: 40px;
        height: 40px;
      }

      .stats-bar {
        padding: 12px 24px;
        gap: 24px;
        font-size: 14px;
      }
    }

    /* Loading overlay */
    .loading-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(13, 17, 23, 0.9);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 1000;
      opacity: 1;
      transition: opacity 0.3s ease;
    }

    .loading-overlay.hidden {
      opacity: 0;
      pointer-events: none;
    }

    .loading-spinner {
      width: 48px;
      height: 48px;
      border: 3px solid var(--border);
      border-top-color: var(--accent);
      border-radius: 50%;
      animation: spin 1s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }
    /* Online bar */
    .online-bar {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      background: var(--card-bg);
      border-bottom: 1px solid var(--border);
      font-size: 12px;
      overflow-x: auto;
      flex-shrink: 0;
      scrollbar-width: none;
    }
    .online-bar::-webkit-scrollbar { display: none; }
    .online-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: var(--success);
      box-shadow: 0 0 6px var(--success);
      flex-shrink: 0;
    }
    .online-text {
      color: var(--text-secondary);
      white-space: nowrap;
      flex-shrink: 0;
    }
    .online-names {
      display: flex;
      gap: 6px;
      overflow-x: auto;
    }
    .online-name {
      background: rgba(63, 185, 80, 0.15);
      color: var(--success);
      padding: 2px 8px;
      border-radius: 10px;
      font-size: 11px;
      font-weight: 600;
      white-space: nowrap;
    }

    /* Leaderboard */
    .leaderboard-toggle {
      padding: 8px 16px;
      background: var(--card-bg);
      border-top: 1px solid var(--border);
      font-size: 13px;
      font-weight: 600;
      color: var(--accent);
      cursor: pointer;
      text-align: center;
      flex-shrink: 0;
    }
    .leaderboard-panel {
      background: var(--card-bg);
      border-top: 1px solid var(--border);
      max-height: 180px;
      overflow-y: auto;
      flex-shrink: 0;
      transition: max-height 0.3s ease;
    }
    .leaderboard-panel.hidden {
      max-height: 0;
      overflow: hidden;
      border-top: none;
    }
    .leaderboard-list {
      padding: 8px 16px;
    }
    .leaderboard-row {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 0;
      font-size: 13px;
      border-bottom: 1px solid var(--border);
    }
    .leaderboard-row:last-child {
      border-bottom: none;
    }
    .leaderboard-rank {
      width: 24px;
      text-align: center;
      font-weight: 700;
      color: var(--accent);
    }
    .leaderboard-rank.gold { color: #ffd700; }
    .leaderboard-rank.silver { color: #c0c0c0; }
    .leaderboard-rank.bronze { color: #cd7f32; }
    .leaderboard-name {
      flex: 1;
      color: var(--text);
      font-weight: 500;
    }
    .leaderboard-count {
      color: var(--text-secondary);
      font-size: 12px;
    }
  </style>
</head>
<body>
  <!-- Loading Overlay -->
  <div id="loading-overlay" class="loading-overlay">
    <div class="loading-spinner"></div>
  </div>

  <!-- Header -->
  <header class="header">
    <div class="header-title">
      <div class="accent-bar"></div>
      <h1>Stateless MCP Canvas</h1>
    </div>
    <div class="status-indicator">
      <div id="status-dot" class="status-dot"></div>
      <span id="status-text">Connecting...</span>
    </div>
  </header>

  <!-- Nickname Input -->
  <div class="nickname-bar">
    <span class="nickname-label">Nickname:</span>
    <input
      type="text"
      id="nickname-input"
      class="nickname-input"
      placeholder="Anonymous"
      maxlength="20"
    />
  </div>

  <!-- Canvas Container -->
  <div class="canvas-container">
    <canvas id="pixel-canvas"></canvas>
  </div>

  <!-- Color Picker -->
  <div class="color-picker">
    <span class="color-picker-label">🎨</span>
    <div class="color-swatch selected" data-color="#f6821f" style="background: #f6821f;"></div>
    <div class="color-swatch" data-color="#ff4444" style="background: #ff4444;"></div>
    <div class="color-swatch" data-color="#44ff44" style="background: #44ff44;"></div>
    <div class="color-swatch" data-color="#4488ff" style="background: #4488ff;"></div>
    <div class="color-swatch" data-color="#ffff44" style="background: #ffff44;"></div>
    <div class="color-swatch" data-color="#ff44ff" style="background: #ff44ff;"></div>
    <div class="color-swatch" data-color="#44ffff" style="background: #44ffff;"></div>
    <div class="color-swatch" data-color="#ffffff" style="background: #ffffff;"></div>
    <div class="color-swatch" data-color="#888888" style="background: #888888;"></div>
    <div class="color-swatch" data-color="#1e2430" style="background: #1e2430; border: 1px solid #30363d;"></div>
  </div>

  <!-- Online Users -->
  <div id="online-bar" class="online-bar">
    <span class="online-dot"></span>
    <span id="online-text" class="online-text">0 online</span>
    <div id="online-names" class="online-names"></div>
  </div>

  <!-- Stats Bar -->
  <div class="stats-bar">
    <div class="stat-item">
      <span id="stat-pixels" class="stat-value">0</span>
      <span>pixels</span>
    </div>
    <div class="stat-item">
      <span id="stat-artists" class="stat-value">0</span>
      <span>artists</span>
    </div>
    <div class="stat-item">
      <span>⚡</span>
      <span id="stat-isolates" class="stat-value">0</span>
      <span>isolates</span>
    </div>
    <div class="stat-item">
      <div id="isolate-dot" class="isolate-dot isolate-0"></div>
    </div>
  </div>

  <!-- Leaderboard (toggleable) -->
  <div id="leaderboard-toggle" class="leaderboard-toggle">🏆 Leaderboard</div>
  <div id="leaderboard-panel" class="leaderboard-panel hidden">
    <div id="leaderboard-list" class="leaderboard-list"></div>
  </div>

  <script>
    // ══════════════════════════════════════════════════════════════
    // Stateless MCP Pixel Canvas
    // Protocol: 2026-07-28 (SEP-1442 stateless mode)
    // ══════════════════════════════════════════════════════════════

    const CONFIG = {
      GRID_SIZE: 32,
      CELL_SIZE: 12,
      MAX_CANVAS_WIDTH: 384,
      SERVER_URL: 'https://mcp.mpinto.space/mcp',
      POLL_INTERVAL: 2000,
      PROTOCOL_VERSION: '2026-07-28',
    };

    const CLIENT_INFO = { name: 'stateless-mcp-canvas', version: '1.0.0' };

    // ── Application State ──
    const state = {
      connected: false,
      selectedColor: '#f6821f',
      nickname: '',
      pixels: new Map(),
      messageId: 0,
      isPlacing: false,
      pollTimer: null,
      lastIsolateId: null,
      isolateColors: new Map(),
      nextIsolateColor: 0,
      stats: {
        totalPixels: 0,
        uniqueArtists: 0,
        uniqueIsolates: 0,
      },
      onlineUsers: [],
      leaderboard: [],
      heartbeatTimer: null,
    };

    // ── DOM Elements ──
    const elements = {
      loadingOverlay: document.getElementById('loading-overlay'),
      statusDot: document.getElementById('status-dot'),
      statusText: document.getElementById('status-text'),
      nicknameInput: document.getElementById('nickname-input'),
      canvas: document.getElementById('pixel-canvas'),
      statPixels: document.getElementById('stat-pixels'),
      statArtists: document.getElementById('stat-artists'),
      statIsolates: document.getElementById('stat-isolates'),
      isolateDot: document.getElementById('isolate-dot'),
      colorSwatches: document.querySelectorAll('.color-swatch'),
      onlineText: document.getElementById('online-text'),
      onlineNames: document.getElementById('online-names'),
      leaderboardToggle: document.getElementById('leaderboard-toggle'),
      leaderboardPanel: document.getElementById('leaderboard-panel'),
      leaderboardList: document.getElementById('leaderboard-list'),
    };

    const ctx = elements.canvas.getContext('2d');

    // ══════════════════════════════════════════════════════════════
    // MCP Client (Stateless Protocol 2026-07-28)
    // ══════════════════════════════════════════════════════════════

    function buildMeta() {
      return {
        'io.modelcontextprotocol/protocolVersion': CONFIG.PROTOCOL_VERSION,
        'io.modelcontextprotocol/clientInfo': CLIENT_INFO,
        'io.modelcontextprotocol/clientCapabilities': {},
      };
    }

    function parseSSEResponse(text) {
      const lines = text.split('\n');
      for (const line of lines) {
        if (line.startsWith('data: ')) {
          try {
            return JSON.parse(line.slice(6));
          } catch (e) {
            console.error('Failed to parse SSE data:', e);
          }
        }
      }
      return null;
    }

    async function sendRequest(method, params = {}) {
      const id = ++state.messageId;

      const enrichedParams = {
        ...params,
        _meta: {
          ...(params._meta || {}),
          ...buildMeta(),
        },
      };

      const request = {
        jsonrpc: '2.0',
        id,
        method,
        params: enrichedParams,
      };

      const headers = {
        'Content-Type': 'application/json',
        'Accept': 'application/json, text/event-stream',
        'MCP-Protocol-Version': CONFIG.PROTOCOL_VERSION,
        'Mcp-Method': method,
      };

      if (method === 'tools/call' && params.name) {
        headers['Mcp-Name'] = params.name;
      }

      const response = await fetch(CONFIG.SERVER_URL, {
        method: 'POST',
        headers,
        body: JSON.stringify(request),
      });

      const contentType = response.headers.get('Content-Type') || '';
      const text = await response.text();

      if (contentType.includes('text/event-stream')) {
        return parseSSEResponse(text);
      } else {
        return JSON.parse(text);
      }
    }

    async function callTool(name, args = {}) {
      return sendRequest('tools/call', { name, arguments: args });
    }

    // ══════════════════════════════════════════════════════════════
    // Canvas Rendering
    // ══════════════════════════════════════════════════════════════

    function setupCanvas() {
      const container = elements.canvas.parentElement;
      const availableWidth = container.clientWidth - 32;
      const availableHeight = container.clientHeight - 32;
      
      const maxSize = Math.min(availableWidth, availableHeight, CONFIG.MAX_CANVAS_WIDTH);
      const cellSize = Math.floor(maxSize / CONFIG.GRID_SIZE);
      const canvasSize = cellSize * CONFIG.GRID_SIZE;

      elements.canvas.width = canvasSize;
      elements.canvas.height = canvasSize;
      elements.canvas.style.width = `${canvasSize}px`;
      elements.canvas.style.height = `${canvasSize}px`;

      CONFIG.CELL_SIZE = cellSize;

      drawCanvas();
    }

    function drawCanvas() {
      const size = elements.canvas.width;
      const cellSize = CONFIG.CELL_SIZE;

      // Clear canvas
      ctx.fillStyle = '#0d1117';
      ctx.fillRect(0, 0, size, size);

      // Draw grid lines
      ctx.strokeStyle = '#1e2430';
      ctx.lineWidth = 1;

      for (let i = 0; i <= CONFIG.GRID_SIZE; i++) {
        const pos = i * cellSize;
        
        ctx.beginPath();
        ctx.moveTo(pos + 0.5, 0);
        ctx.lineTo(pos + 0.5, size);
        ctx.stroke();

        ctx.beginPath();
        ctx.moveTo(0, pos + 0.5);
        ctx.lineTo(size, pos + 0.5);
        ctx.stroke();
      }

      // Draw pixels
      for (const [key, pixel] of state.pixels) {
        drawPixel(pixel.x, pixel.y, pixel.color, pixel.isolate_id);
      }
    }

    function drawPixel(x, y, color, isolateId = null) {
      const cellSize = CONFIG.CELL_SIZE;
      const px = x * cellSize;
      const py = y * cellSize;

      // Fill the cell
      ctx.fillStyle = color;
      ctx.fillRect(px + 1, py + 1, cellSize - 2, cellSize - 2);

      // Optional: subtle glow based on isolate
      if (isolateId && state.isolateColors.has(isolateId)) {
        const glowColor = getIsolateColorHex(isolateId);
        ctx.strokeStyle = glowColor;
        ctx.lineWidth = 1;
        ctx.strokeRect(px + 0.5, py + 0.5, cellSize - 1, cellSize - 1);
      }
    }

    function getIsolateColorIndex(isolateId) {
      if (!state.isolateColors.has(isolateId)) {
        state.isolateColors.set(isolateId, state.nextIsolateColor % 8);
        state.nextIsolateColor++;
      }
      return state.isolateColors.get(isolateId);
    }

    function getIsolateColorHex(isolateId) {
      const colors = ['#f6821f', '#3fb950', '#8884d8', '#82ca9d', '#ffc658', '#ff8080', '#80c8ff', '#c880ff'];
      return colors[getIsolateColorIndex(isolateId)];
    }

    // ══════════════════════════════════════════════════════════════
    // Canvas Interaction
    // ══════════════════════════════════════════════════════════════

    function getCellFromEvent(event) {
      const rect = elements.canvas.getBoundingClientRect();
      let clientX, clientY;

      if (event.touches && event.touches.length > 0) {
        clientX = event.touches[0].clientX;
        clientY = event.touches[0].clientY;
      } else {
        clientX = event.clientX;
        clientY = event.clientY;
      }

      const x = Math.floor((clientX - rect.left) / CONFIG.CELL_SIZE);
      const y = Math.floor((clientY - rect.top) / CONFIG.CELL_SIZE);

      if (x >= 0 && x < CONFIG.GRID_SIZE && y >= 0 && y < CONFIG.GRID_SIZE) {
        return { x, y };
      }
      return null;
    }

    async function handleCanvasTap(event) {
      event.preventDefault();

      const cell = getCellFromEvent(event);
      if (!cell) return;

      const { x, y } = cell;
      const color = state.selectedColor;
      const nickname = state.nickname || 'Anonymous';

      // Optimistic update
      const key = `${x},${y}`;
      state.pixels.set(key, { x, y, color, artist: nickname, isolate_id: null });
      drawCanvas();

      // Don't send if already placing
      if (state.isPlacing) return;

      state.isPlacing = true;

      try {
        const response = await callTool('place_pixel', {
          x,
          y,
          color,
          nickname,
        });

        if (response.result && response.result.content) {
          for (const item of response.result.content) {
            if (item.type === 'text') {
              try {
                const data = JSON.parse(item.text);
                if (data.isolate_id || data.handled_by_isolate) {
                  state.lastIsolateId = data.isolate_id || data.handled_by_isolate;
                  updateIsolateDot();
                }
              } catch (e) {}
            }
          }
        }
      } catch (error) {
        console.error('Failed to place pixel:', error);
      } finally {
        state.isPlacing = false;
      }
    }

    // ══════════════════════════════════════════════════════════════
    // Polling & Canvas Sync
    // ══════════════════════════════════════════════════════════════

    async function fetchCanvas() {
      try {
        const response = await callTool('get_canvas', {});

        if (response.result && response.result.content) {
          for (const item of response.result.content) {
            if (item.type === 'text') {
              try {
                const data = JSON.parse(item.text);

                // Update pixels (server returns data.canvas.pixels)
                const pixels = data.canvas?.pixels || data.pixels;
                if (pixels && Array.isArray(pixels)) {
                  state.pixels.clear();
                  for (const pixel of pixels) {
                    const key = `${pixel.x},${pixel.y}`;
                    state.pixels.set(key, pixel);
                    if (pixel.isolate_id) {
                      getIsolateColorIndex(pixel.isolate_id);
                    }
                  }
                  drawCanvas();
                }

                // Update stats (server returns data.metadata.*)
                const meta = data.metadata || data;
                if (typeof meta.total_pixels === 'number') {
                  state.stats.totalPixels = meta.total_pixels;
                }
                if (typeof meta.unique_artists === 'number') {
                  state.stats.uniqueArtists = meta.unique_artists;
                }
                if (typeof meta.unique_isolates === 'number') {
                  state.stats.uniqueIsolates = meta.unique_isolates;
                }

                // Online users
                if (Array.isArray(data.online_users)) {
                  state.onlineUsers = data.online_users;
                  updateOnlineUsers();
                }

                // Leaderboard
                if (Array.isArray(data.leaderboard)) {
                  state.leaderboard = data.leaderboard;
                  updateLeaderboard();
                }

                // Track isolate
                if (data.isolate_id || data.handled_by_isolate) {
                  state.lastIsolateId = data.isolate_id || data.handled_by_isolate;
                }

                updateStats();
                updateIsolateDot();

              } catch (e) {
                console.error('Failed to parse canvas data:', e);
              }
            }
          }
        }

        if (!state.connected) {
          state.connected = true;
          updateStatus('connected', 'Connected');
          elements.loadingOverlay.classList.add('hidden');
        }

      } catch (error) {
        console.error('Failed to fetch canvas:', error);
        updateStatus('error', 'Disconnected');
        state.connected = false;
      }
    }

    function startPolling() {
      fetchCanvas();
      state.pollTimer = setInterval(() => {
        if (!state.isPlacing) {
          fetchCanvas();
        }
      }, CONFIG.POLL_INTERVAL);
    }

    function stopPolling() {
      if (state.pollTimer) {
        clearInterval(state.pollTimer);
        state.pollTimer = null;
      }
    }

    // ══════════════════════════════════════════════════════════════
    // UI Updates
    // ══════════════════════════════════════════════════════════════

    function updateStatus(status, text) {
      elements.statusDot.className = 'status-dot ' + status;
      elements.statusText.textContent = text;
    }

    function updateStats() {
      elements.statPixels.textContent = state.stats.totalPixels;
      elements.statArtists.textContent = state.stats.uniqueArtists;
      elements.statIsolates.textContent = state.stats.uniqueIsolates;
    }

    function updateIsolateDot() {
      if (state.lastIsolateId) {
        const colorIndex = getIsolateColorIndex(state.lastIsolateId);
        elements.isolateDot.className = `isolate-dot isolate-${colorIndex}`;
      }
    }

    function selectColor(color) {
      state.selectedColor = color;

      elements.colorSwatches.forEach(swatch => {
        if (swatch.dataset.color === color) {
          swatch.classList.add('selected');
        } else {
          swatch.classList.remove('selected');
        }
      });
    }

    // ══════════════════════════════════════════════════════════════
    // Heartbeat (presence tracking via stateless MCP)
    // ══════════════════════════════════════════════════════════════

    async function sendHeartbeat() {
      const nickname = state.nickname || 'anonymous';
      try {
        await callTool('heartbeat', { nickname });
      } catch (e) {
        // Silent fail - heartbeat is best-effort
      }
    }

    function startHeartbeat() {
      sendHeartbeat();
      state.heartbeatTimer = setInterval(sendHeartbeat, 5000);
    }

    function stopHeartbeat() {
      if (state.heartbeatTimer) {
        clearInterval(state.heartbeatTimer);
        state.heartbeatTimer = null;
      }
    }

    // ══════════════════════════════════════════════════════════════
    // Online Users & Leaderboard
    // ══════════════════════════════════════════════════════════════

    function updateOnlineUsers() {
      const count = state.onlineUsers.length;
      elements.onlineText.textContent = `${count} online`;
      elements.onlineNames.innerHTML = state.onlineUsers
        .map(name => `<span class="online-name">${escapeHtml(name)}</span>`)
        .join('');
    }

    function updateLeaderboard() {
      if (state.leaderboard.length === 0) {
        elements.leaderboardList.innerHTML = '<div style="color: var(--text-secondary); padding: 12px 0; text-align: center; font-size: 13px;">No pixels placed yet</div>';
        return;
      }
      elements.leaderboardList.innerHTML = state.leaderboard
        .map(entry => {
          const medals = ['🥇', '🥈', '🥉'];
          const medal = medals[entry.rank - 1] || entry.rank;
          const rankClass = entry.rank === 1 ? 'gold' : entry.rank === 2 ? 'silver' : entry.rank === 3 ? 'bronze' : '';
          return `<div class="leaderboard-row">
            <span class="leaderboard-rank ${rankClass}">${medal}</span>
            <span class="leaderboard-name">${escapeHtml(entry.name)}</span>
            <span class="leaderboard-count">${entry.pixels} px</span>
          </div>`;
        })
        .join('');
    }

    function escapeHtml(text) {
      const div = document.createElement('div');
      div.textContent = text;
      return div.innerHTML;
    }

    // ══════════════════════════════════════════════════════════════
    // Event Listeners
    // ══════════════════════════════════════════════════════════════

    // Canvas touch/click
    elements.canvas.addEventListener('touchstart', handleCanvasTap, { passive: false });
    elements.canvas.addEventListener('click', handleCanvasTap);

    // Color picker
    elements.colorSwatches.forEach(swatch => {
      swatch.addEventListener('click', () => {
        selectColor(swatch.dataset.color);
      });
    });

    // Nickname input
    elements.nicknameInput.addEventListener('input', (e) => {
      state.nickname = e.target.value.trim();
      localStorage.setItem('mcp-canvas-nickname', state.nickname);
    });

    // Leaderboard toggle
    elements.leaderboardToggle.addEventListener('click', () => {
      elements.leaderboardPanel.classList.toggle('hidden');
      elements.leaderboardToggle.textContent = elements.leaderboardPanel.classList.contains('hidden')
        ? '🏆 Leaderboard'
        : '🏆 Hide Leaderboard';
    });

    // Restore nickname from localStorage
    const savedNickname = localStorage.getItem('mcp-canvas-nickname');
    if (savedNickname) {
      state.nickname = savedNickname;
      elements.nicknameInput.value = savedNickname;
    }

    // Window resize
    let resizeTimer;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(() => {
        setupCanvas();
      }, 100);
    });

    // ══════════════════════════════════════════════════════════════
    // Initialization
    // ══════════════════════════════════════════════════════════════

    function init() {
      updateStatus('connecting', 'Connecting...');
      setupCanvas();
      startPolling();
      startHeartbeat();
    }

    init();
  </script>
</body>
</html>
