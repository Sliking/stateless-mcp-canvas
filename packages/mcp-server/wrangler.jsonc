{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stateless-mcp-demo-server",
  "main": "src/index.ts",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat"],

  // No Durable Objects - this is a truly stateless MCP server.
  // Every request is self-contained, handled by any Worker isolate.
  // No sessions, no sticky routing, no state coordination.
  // This is the point of SEP-1442: stateless MCP by default.
  //
  // Canvas state lives in KV (external store), not in the server.
  // The server is stateless. The state is external.

  "routes": [
    { "pattern": "mcp.mpinto.space", "custom_domain": true }
  ],

  "kv_namespaces": [
    {
      "binding": "CANVAS_KV",
      "id": "79d0495cb873449f9c17d3e2747b3e97"
    }
  ],

  "observability": {
    "enabled": true
  }
}
